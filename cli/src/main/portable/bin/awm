#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
CLI_HOME=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)

if [ -x "$CLI_HOME/../runtime/bin/java" ]; then
  AWM_JAVA="$CLI_HOME/../runtime/bin/java"
elif [ -x "$CLI_HOME/../../../runtime/bin/java" ]; then
  AWM_JAVA="$CLI_HOME/../../../runtime/bin/java"
elif [ -x "$CLI_HOME/../../../runtime/Contents/Home/bin/java" ]; then
  AWM_JAVA="$CLI_HOME/../../../runtime/Contents/Home/bin/java"
elif [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ]; then
  AWM_JAVA="$JAVA_HOME/bin/java"
else
  AWM_JAVA=java
fi

exec "$AWM_JAVA" -cp "$CLI_HOME/lib/*" com.snowball.awm.cli.MainKt "$@"
